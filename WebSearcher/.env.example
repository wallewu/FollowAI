# WebSearcher MCP Server Configuration

# Search Engine API Configuration
# Choose one of the following search engines and provide the corresponding API key

# Google Custom Search API
# Get your API key from: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Bing Search API
# Get your API key from: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_API_KEY=your_bing_api_key_here

# SerpAPI (supports multiple search engines)
# Get your API key from: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Search Engine Selection
# Options: google, bing, serpapi
SEARCH_ENGINE=serpapi

# Search Configuration
MAX_RESULTS=10
REQUEST_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false
